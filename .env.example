# QoderGateway environment example
# Copy this file to .env or set these variables in your shell.
# Only variables actually read by the code are listed here.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Bind address / port of the gateway (uvicorn).
QODER_HOST=127.0.0.1
QODER_PORT=5050

# Administrator password for the management console.
# When set, this overrides the SQLite-stored gateway token.
QODER_ADMIN_PASSWORD=admin

# ---------------------------------------------------------------------------
# Proxy (outbound HTTP, Python side: upstream API calls / temp-mail client)
# ---------------------------------------------------------------------------
# Format: http://127.0.0.1:7890  (also read as LOCAL_PROXY by the mail client)
# Leave empty to connect directly.
# NOTE: per-account proxies (console > Account Pool > vpn_lock button) take
# precedence over this global value; an account with the proxy switch off
# falls back to this variable, then to a direct connection.
QODER_PROXY=

# ---------------------------------------------------------------------------
# Temp-mail proxy (Emailnator / YYDS API calls from the registrar)
# ---------------------------------------------------------------------------
# Whether temp-mail API calls go through an HTTP proxy.
# 1/true = use proxy (default), 0/false = direct connection.
QODER_MAIL_PROXY=1

# Proxy address for temp-mail calls (ip:port or full URL).
# Priority: QODER_MAIL_PROXY_URL > LOCAL_PROXY > QODER_PROXY.
# When none is set, falls back to the built-in default http://127.0.0.1:7897.
# Examples: http://127.0.0.1:7890  |  socks5://127.0.0.1:7891
QODER_MAIL_PROXY_URL=

# ---------------------------------------------------------------------------
# Registrar proxy (auto-registration browser, DrissionPage/Chrome)
# ---------------------------------------------------------------------------
# Whether the registration browser goes through an HTTP proxy.
# 1/true = use proxy, 0/false/empty = direct connection.
QODER_REGISTRAR_PROXY=0

# Proxy address for the registration browser (ip:port or full URL).
# Takes QODER_REGISTRAR_PROXY_URL first; falls back to QODER_PROXY when empty.
# Examples: http://127.0.0.1:7890  |  socks5://127.0.0.1:7891
QODER_REGISTRAR_PROXY_URL=

# ---------------------------------------------------------------------------
# Concurrency / connection pool
# ---------------------------------------------------------------------------
# Process-wide in-flight request cap (streaming holds a slot for its whole life).
# Excess requests get 429 + Retry-After after QODER_GATE_WAIT seconds of queuing.
QODER_MAX_CONCURRENCY=300
QODER_GATE_WAIT=15

# Shared upstream httpx connection pool (TLS reuse across requests).
QODER_HTTP_MAX_CONNECTIONS=200
QODER_HTTP_KEEPALIVE=100

# Max simultaneous upstream requests per account (protects upstream quota;
# requests beyond this queue up to QODER_ACCOUNT_SLOT_WAIT then rotate account).
QODER_ACCOUNT_CONCURRENCY=4
QODER_ACCOUNT_SLOT_WAIT=30

# SessionContext cache TTL in seconds (avoids per-request sqlite read + RSA/AES
# signing on the event loop). Invalidated automatically on token refresh.
QODER_SESSION_CACHE_TTL=60

# ---------------------------------------------------------------------------
# Registrar behaviour
# ---------------------------------------------------------------------------
# Automatic slider-captcha solving. 0/false = always fall back to manual.
QODER_SLIDER_AUTO=1

# ---------------------------------------------------------------------------
# Bridge / upstream protocol
# ---------------------------------------------------------------------------
# 1 = old api3 protocol (COSY signed, all models), 0 = new api2-v2 protocol.
QODER_USE_OLD_PROTOCOL=1

# First-token timeout in seconds. The old protocol HANGS (no error) when the
# account has no quota for the requested model, so this is what detects it.
QODER_FIRST_TOKEN_TIMEOUT=60

# Mid-stream read timeout (seconds) and total non-stream timeout (seconds).
QODER_STREAM_READ_TIMEOUT=120
QODER_TOTAL_TIMEOUT=300

# ---------------------------------------------------------------------------
# Accounts
# ---------------------------------------------------------------------------
# Optional PAT auto-imported on first startup when no accounts exist.
QODER_PAT=

# ---------------------------------------------------------------------------
# Temp mail
# ---------------------------------------------------------------------------
# Backend used by the auto registrar: emailnator | yyds
QODER_MAIL_BACKEND=emailnator

# YYDS Mail API key (AC- prefix), only needed when QODER_MAIL_BACKEND=yyds.
YYDS_API_KEY=AC-xxx

# YYDS API base URL. Default: https://vip.215.im/v1
# NOTE: the old host maliapi.215.im is dead — its TLS certificate only covers
# raw IPs (no DNS SAN), so hostname verification fails and every request 302s
# to m.baidu.com. Only override this if the provider migrates again.
# YYDS_API_BASE=https://vip.215.im/v1
